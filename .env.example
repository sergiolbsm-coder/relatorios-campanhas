# Credenciais de API — copie para .env e preencha. NUNCA commitar o .env real.
# Arquitetura B (custom): scripts próprios direto nas APIs oficiais de cada plataforma.
# Ver docs/architecture-decision.md para o porquê da mudança de arquitetura.

# ---------------------------------------------------------------------------
# Google Ads API
# Precisa: projeto no Google Cloud + API ativada + developer token aprovado
# (o developer token de teste só funciona com contas de teste; produção exige
# aprovação da Google, que pode levar dias — iniciar isso cedo).
# ---------------------------------------------------------------------------
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
# MCC "Sergio Moura" — necessário para acessar a conta da Associação de Luto União
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# Meta Marketing API (Facebook Ads + Instagram Insights)
# Precisa: app no Meta for Developers + token de longa duração (60 dias,
# renovar via fluxo de refresh antes de expirar — configurar alerta na Fase 2.8)
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Google Analytics Data API (GA4)
# Precisa: service account no mesmo projeto GCP do Google Ads (ou outro),
# com o e-mail da service account adicionado como "Viewer" na propriedade GA4
# 450305882 (Instituto da Liderança) no GA4 Admin.
# ---------------------------------------------------------------------------
GA4_SERVICE_ACCOUNT_JSON_PATH=./secrets/ga4-service-account.json

# ---------------------------------------------------------------------------
# Google Business Profile API (Google Meu Negócio)
# Precisa: Business Profile API habilitada no GCP + acesso concedido à conta
# access_status "pending" por padrão — a aprovação da Google pode levar dias.
# ---------------------------------------------------------------------------
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Google Tag Manager API (auditoria de instrumentação, Fase 2.6/6)
# ---------------------------------------------------------------------------
GTM_CLIENT_ID=
GTM_CLIENT_SECRET=
GTM_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Banco de dados (Fase 3)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/campanhas

# ---------------------------------------------------------------------------
# Alertas (Fase 2.8 / 5.2)
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
